# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://parcelpilot:parcelpilot@localhost:5432/parcelpilot

# --- Chat: the agent loop -------------------------------------------------
# Cerebras is OpenAI-compatible, so it is driven through the openai SDK with a
# custom base_url. Flip CHAT_PROVIDER to `gemini` if the pre-Phase-5 tool
# calling spike scores below 9/10 -- that is the whole switch.
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-flash-latest
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- Embeddings -----------------------------------------------------------
# Cerebras has no embeddings endpoint. gemini-embedding-001 supports Matryoshka
# output dims, and 1536 matches the VECTOR(1536) column exactly.
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536
GEMINI_API_KEY=

# --- Judge / signal naming ------------------------------------------------
# Deliberately NOT the answering model: a model grading its own output inflates
# the score.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.1-flash-lite

# --- Agent behaviour ------------------------------------------------------
MAX_AGENT_STEPS=8
PENDING_ACTION_TTL_MINUTES=15
RETRIEVAL_K=8
ENABLE_DEPRECATED_DOCS_FOR_INTERNAL=true
LOG_LEVEL=info

# --- Business calendar (assumption A3) ------------------------------------
# "business hours"/"business days" are never defined in the source documents.
BUSINESS_TZ=Asia/Kolkata
BUSINESS_DAY_START=09:00
BUSINESS_DAY_END=18:00

DATA_DIR=./data
