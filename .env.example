# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://parcelpilot:parcelpilot@localhost:5432/parcelpilot

# --- Chat: the agent loop -------------------------------------------------
# Cerebras is OpenAI-compatible, so it is driven through the openai SDK with a
# custom base_url. Flip CHAT_PROVIDER to `gemini` if the pre-Phase-5 tool
# calling spike scores below 9/10 -- that is the whole switch.
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-flash-latest
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- Embeddings -----------------------------------------------------------
# Cerebras has no embeddings endpoint. gemini-embedding-001 supports Matryoshka
# output dims, and 1536 matches the VECTOR(1536) column exactly.
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536
GEMINI_API_KEY=

# --- Gemini auth mode -------------------------------------------------------
# api_key: Gemini Developer API. Free tier caps at ~20 requests/day/model,
#          which is what blocked the full tool-calling spike and eval run --
#          see docs/decisions/0001-gemini-quota-and-spike-gate.md.
# vertex:  Vertex AI via a GCP service account key. Separate, much larger
#          quota. To use it:
#            1. cp backend/credentials/vertex-service-account.example.json \
#                  backend/credentials/vertex-service-account.json
#            2. Paste your real downloaded service account key's JSON into
#               that file (it is gitignored; the .example one is not).
#            3. Set GEMINI_AUTH_MODE=vertex below.
#          VERTEX_PROJECT_ID is optional -- if left blank, it is read from
#          the "project_id" field already inside the key file, so it cannot
#          quietly disagree with the key you pasted in.
#          GEMINI_API_KEY above is then unused for chat/embeddings, but is
#          harmless to leave set.
GEMINI_AUTH_MODE=api_key
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_CREDENTIALS_PATH=credentials/vertex-service-account.json

# --- Judge / signal naming ------------------------------------------------
# Deliberately NOT the answering model: a model grading its own output inflates
# the score.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.1-flash-lite

# --- Agent behaviour ------------------------------------------------------
MAX_AGENT_STEPS=8
PENDING_ACTION_TTL_MINUTES=15
RETRIEVAL_K=8
ENABLE_DEPRECATED_DOCS_FOR_INTERNAL=true
LOG_LEVEL=info

# --- Business calendar (assumption A3) ------------------------------------
# "business hours"/"business days" are never defined in the source documents.
BUSINESS_TZ=Asia/Kolkata
BUSINESS_DAY_START=09:00
BUSINESS_DAY_END=18:00

DATA_DIR=./data
